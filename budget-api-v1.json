            }
          },
          {
            "name": "iban",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TransactionResponseModel"
                  }
                }
              },
              "application/json": {
                "schema": {
                  "type": "array",
