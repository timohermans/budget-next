  "components": {
    "schemas": {
      "BalanceAtDateDto": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "balance": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "CashflowDto": {
        "required": [
          "iban",
          "balancesPerDate"
        ],
        "type": "object",
        "properties": {
          "iban": {
            "type": "string"
          },
          "balancesPerDate": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BalanceAtDateDto"
            }
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "nullable": true
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "detail": {
            "type": "string",
            "nullable": true
          },
          "instance": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "Response": {
        "type": "object",
        "properties": {
          "jobId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "Response2": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "cashbackForDate": {
            "type": "string",
            "format": "date",
            "nullable": true
          }
        }
      },
      "TransactionPatchCashbackDateCommandModel": {
        "type": "object",
        "properties": {
          "cashbackForDate": {
            "type": "string",
            "format": "date",
            "nullable": true
          }
        }
      },
      "TransactionResponseModel": {
        "required": [
          "iban"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "followNumber": {
            "type": "integer",
            "format": "int32"
          },
          "iban": {
            "type": "string"
          },
          "amount": {
            "type": "number",
            "format": "double"
          },
          "dateTransaction": {
            "type": "string",
            "format": "date"
          },
          "nameOtherParty": {
            "type": "string",
            "nullable": true
          },
          "ibanOtherParty": {
            "type": "string",
            "nullable": true
          },
          "authorizationCode": {
            "type": "string",
            "nullable": true
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "cashbackForDate": {
            "type": "string",
            "format": "date",
            "nullable": true
          }
        }
      },
      "TransactionsFileJobResponseModel": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "originalFileName": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "processedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "status": {
            "type": "string",
            "nullable": true
          },
          "errorMessage": {
            "type": "string",
            "nullable": true
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Transactions"
    },
    {
      "name": "TransactionsFileJob"
    }
  ]
